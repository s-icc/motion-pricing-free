{
  "name": "motion-pricing-free-source",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "examples/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run build -w @motion-pricing/core && npm run build -w @motion-pricing/free && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "validate": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  }
}

